<Window
    x:Class="HytaleServerManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Iniciador do Servidor Hytale">

    <Grid x:Name="Root" Background="#E80B1018">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Padding="18,0,140,0" Background="#780B1018">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}">
                <TextBlock Text="H" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedWorldName}" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="CENTRAL DO SERVIDOR" FontSize="9" Foreground="{StaticResource SubtleTextBrush}" CharacterSpacing="140" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Notice}" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,18,24,24" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" MinWidth="650" />
                <ColumnDefinition Width="1*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="SERVIDOR" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                    <Ellipse Width="9" Height="9" Fill="{Binding ServerStatusBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding ServerStatus}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PortStatus}" Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <TextBlock Text="TÚNEL" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                    <Ellipse Width="9" Height="9" Fill="{Binding TunnelStatusBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <TextBlock Text="{Binding TunnelStatus}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Playit.gg 1.0.12" Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="SESSÃO" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                <TextBlock Text="{Binding Uptime}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlayerCountText}" Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="6">
                                <TextBlock Text="ENDEREÇO PÚBLICO" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                <TextBlock Text="{Binding Settings.PublicAddress}" FontFamily="Cascadia Mono" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock Text="Compartilhe somente este endereço com seus amigos." Foreground="{StaticResource SubtleTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CopyAddressCommand}" Padding="18,10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="Copiar IP" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="PROCESSADOR" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                    <TextBlock Text="{Binding CpuText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <ProgressBar Value="{Binding CpuPercent}" Maximum="100" Height="6" />
                                <TextBlock Text="Uso estimado pelo processo Java" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <TextBlock Text="MEMÓRIA" Foreground="{StaticResource SubtleTextBrush}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120" />
                                    <TextBlock Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <ProgressBar Value="{Binding MemoryMb}" Maximum="{Binding Settings.MaximumMemoryMb}" Height="6" />
                                <TextBlock Text="Memória física usada pelo servidor" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Padding="0">
                        <Grid Height="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Padding="18,0">
                                <TextBlock Text="CONSOLE AO VIVO" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Command="{Binding ClearLogsCommand}" Content="Limpar" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ListView x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" SelectionMode="None" Background="#B0080C13" Padding="12" Loaded="LogList_Loaded">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono" FontSize="11" Foreground="#FFD2D8E6" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid Grid.Row="2" Padding="12" ColumnSpacing="8" Background="#B0080C13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ConsoleCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Digite um comando, por exemplo /auth status" FontFamily="Cascadia Mono" />
                                <Button Grid.Column="1" Command="{Binding SendConsoleCommand}" Content="Enviar" Padding="18,9" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="PRIMEIRA EXECUÇÃO" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{Binding HytaleSetupBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding HytaleInstallStatus}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding HytaleAuthStatus}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Autorização do Hytale" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                            <Border Background="#90101925" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
                                <TextBlock Text="{Binding HytaleAuthCode}" FontFamily="Cascadia Mono" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </Border>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding BeginHytaleAuthCommand}" Content="Gerar código" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding OpenHytaleAuthPageCommand}" Content="Abrir confirmação" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Button Command="{Binding CopyAuthCodeCommand}" Content="Copiar código" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

                            <Rectangle Height="1" Fill="{StaticResource CardBorderBrush}" Margin="0,4" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{Binding PlayitSetupBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding PlayitInstallStatus}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PlayitLinkStatus}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding OpenPlayitDownloadCommand}" Content="Baixar Playit" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding StartPlayitSetupCommand}" Content="Vincular agente" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                            <Button Command="{Binding OpenPlayitDashboardCommand}" Content="Abrir painel do Playit.gg" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="MUNDO" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />
                            <ComboBox ItemsSource="{Binding Worlds}"
                                      SelectedItem="{Binding SelectedWorld, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding CanSelectWorld}"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="Selecione um mundo" />
                            <TextBlock Text="{Binding WorldCountText}" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBlock Text="{Binding SelectedWorldPath}" FontFamily="Cascadia Mono" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Para trocar, desligue o servidor atual." FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                            <Button Command="{Binding ReloadWorldsCommand}" Content="Atualizar lista de mundos" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="CONTROLES" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />
                            <Button Command="{Binding StartCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14" Background="{StaticResource AccentBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                                    <TextBlock Text="Iniciar tudo" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="14">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                                    <TextBlock Text="Salvar e parar servidor" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StopTunnelCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12">
                                <TextBlock Text="Desligar somente o túnel" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="RECURSOS" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />
                            <TextBlock Text="Memória inicial (MB)" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox Text="{Binding InitialMemoryText, Mode=TwoWay}" PlaceholderText="768" />
                            <TextBlock Text="Memória máxima (MB)" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox Text="{Binding MaximumMemoryText, Mode=TwoWay}" PlaceholderText="4096" />
                            <TextBlock Text="As alterações valem na próxima inicialização." FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="CONFIGURAÇÃO" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />
                            <TextBlock Text="Endereço público" Foreground="{StaticResource SubtleTextBrush}" />
                            <TextBox Text="{Binding Settings.PublicAddress, Mode=TwoWay}" />
                            <TextBlock Text="Use o endereço do túnel criado na conta Playit deste computador." FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Porta UDP local" Foreground="{StaticResource SubtleTextBrush}" />
                            <NumberBox Value="{Binding Settings.ServerPort, Mode=TwoWay}" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" />
                            <Button Command="{Binding SaveSettingsCommand}" Content="Salvar configurações" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <Button Command="{Binding OpenWorldCommand}" Content="Abrir pasta do mundo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="JOGADORES ONLINE" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" FontWeight="SemiBold" CharacterSpacing="120" />
                            <TextBlock Text="{Binding PlayerCountText}" FontSize="20" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,4" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
